{
  "name": "@cvr/herdr-hunk",
  "version": "0.0.0",
  "description": "Send Hunk review notes to the correct Herdr agent pane",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/cevr/herdr-hunk"
  },
  "bin": {
    "herdr-hunk": "./bin/herdr-hunk"
  },
  "files": [
    "scripts",
    "src",
    "herdr-plugin.toml",
    "tsconfig.json"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "dev": "bun run src/main.ts",
    "build": "bun run scripts/build.ts",
    "link": "bun run build",
    "typecheck": "tsgo --noEmit",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "test": "bun test",
    "gate": "concurrently -n type,lint,fmt,test,build -c blue,yellow,magenta,green,cyan \"bun run typecheck\" \"bun run lint\" \"bun run fmt:check\" \"bun run test\" \"bun run build\"",
    "version": "changeset version",
    "release": "changeset publish",
    "postinstall": "bun run build",
    "prepare": "lefthook install && effect-tsgo patch"
  },
  "dependencies": {
    "@effect/platform-bun": "4.0.0-beta.102",
    "effect": "4.0.0-beta.102"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.7.0",
    "@changesets/cli": "^2.31.1",
    "@effect/tsgo": "^0.24.0",
    "@types/bun": "^1.3.14",
    "@typescript/native-preview": "^7.0.0-dev.20260707.2",
    "concurrently": "^10.0.4",
    "effect-bun-test": "^0.3.0",
    "lefthook": "^2.1.10",
    "oxfmt": "^0.61.0",
    "oxlint": "^1.76.0",
    "oxlint-plugin-effect": "^0.2.3",
    "typescript": "^7.0.2"
  },
  "engines": {
    "bun": ">=1.3.0"
  }
}
